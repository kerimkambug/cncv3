# Bos birak / bu satiri yorum yap -> sunucu otomatik olarak
# server/data/presets.json dosyasina yazar, hicbir kurulum gerekmez.
#
# MongoDB'yi baglamaya hazir oldugunda asagidaki satirin basindaki
# # isaretini kaldirip kendi baglanti adresini yaz, sunucuyu yeniden baslat.
# MONGODB_URI=mongodb://127.0.0.1:27017/empire_cnc

PORT=4000

# Depth Anything V2 AI Mikroservisi (server/ai_service)
AI_SERVICE_URL=http://127.0.0.1:8000
# AI derinlik çıkarımında kullanılacak maksimum uzun kenar (piksel).
# 2048 = 4K'ya yakın kalite (önerilen, performans/detay dengesi).
# Tam 4K için 3840 yapıp AI servisini yeniden başlatın (CPU/VRAM yükü artar).
# AI_MAX_INPUT_PX=3840

